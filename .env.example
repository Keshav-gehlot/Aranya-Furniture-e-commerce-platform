# ─── Local development ───────────────────────────────────────────────
# `npm run db:local` starts a private PostgreSQL on port 5433 with these credentials.
DATABASE_URL="postgresql://app:app@127.0.0.1:5433/furniture"
TEST_DATABASE_URL="postgresql://app:app@127.0.0.1:5433/furniture_test"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Long random strings. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-at-least-32-random-characters"
CRON_SECRET="replace-with-a-random-string"
# Exactly 32 random bytes, base64. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it forever: changing it makes everyone's authenticator setup invalid.
MFA_ENCRYPTION_KEY="replace-me"

# First administrator (used by `npm run db:seed`, and by the first start on Prisma Compute). Password: 12+ characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# ─── Payments (leave empty locally to use the demo payment button) ───
# Razorpay (INR) — Dashboard → Account & Settings → API Keys (use Test Mode keys first)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Stripe (USD) — Developers → API keys (test keys start with sk_test_)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Simulated payments: on in development. In a production build they work only on a staging
# deployment that sets BOTH DEPLOYMENT_STAGE="staging" and ALLOW_DEMO_PAYMENTS="true".
ALLOW_DEMO_PAYMENTS="true"
# DEPLOYMENT_STAGE="staging"            # staging banner, noindex, allows simulated payments

# ─── Optional ────────────────────────────────────────────────────────
RESEND_API_KEY=""                       # order/enquiry alerts and staff invite emails
EMAIL_FROM="Store <onboarding@resend.dev>"
NOTIFY_EMAIL=""                          # can also be set in Admin → Settings
STORAGE_DRIVER="local"                   # "s3" in AWS (set by Terraform), "db" on hosts with no disk (Vercel, Prisma Compute)
# S3_BUCKET=""  ASSET_BASE_URL=""  AWS_REGION="ap-south-1"

# ─── Hosted PostgreSQL ───────────────────────────────────────────────
# DATABASE_SSL="true"                    # verify the server certificate (RDS; or any host with DATABASE_CA_CERT set)
# DATABASE_SSL="require"                 # encrypt without verifying (staging only)
# DATABASE_CA_CERT=""                    # PEM certificate of the database's CA
# DATABASE_POOL_MAX="3"
