{
  "name": "furniture-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:store": "node tests/e2e/storefront-flow.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/local-db.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fontsource-variable/anek-latin": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.7",
    "jose": "5.9.6",
    "lucide-react": "^1.71.0",
    "next": "^15.5.29",
    "otpauth": "^9.3.6",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "stripe": "17.7.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.6",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.20",
    "embedded-postgres": "^17.5.0-beta.15",
    "playwright": "^1.56.1",
    "postcss": "8.4.49",
    "prisma": "7.10.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "^2.1.8"
  }
}
